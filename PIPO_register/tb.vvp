    .scope S_0x56077cd07be0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56077cd1d1d0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x56077cd07be0;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x56077cd1d1d0_0;
    %inv;
    %store/vec4 v0x56077cd1d1d0_0, 0, 1;
