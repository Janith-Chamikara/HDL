    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56077cd07be0 {0 0 0};
    %vpi_call 2 25 "$monitor", "At TIME %t | RESET = %b | CLK = %b | EN = %b | DATA_IN = %b | DATA_OUT = %b", $time, v0x56077cd1d560_0, v0x56077cd1d1d0_0, v0x56077cd1d490_0, v0x56077cd1d2c0_0, v0x56077cd1d390_0 {0 0 0};
