E_0x56077cccdd00 .event posedge, v0x56077cd1d020_0, v0x56077cccd490_0;
    .scope S_0x56077cd07d70;
T_0 ;
    %wait E_0x56077cccdd00;
    %load/vec4 v0x56077cd1d020_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x56077cd1ce70_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x56077cd1cf60_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x56077cd1cd90_0;
    %assign/vec4 v0x56077cd1ce70_0, 0;
T_0.2 ;
T_0.1 ;
