#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x645ba693b810 .scope module, "tb" "tb" 2 3;
 .timescale 0 0;
v0x645ba694efc0_0 .var "A", 3 0;
v0x645ba694f0a0_0 .var "B", 3 0;
v0x645ba694f170_0 .net "eq", 0 0, v0x645ba694ec80_0;  1 drivers
v0x645ba694f270_0 .net "gt", 0 0, v0x645ba694ed50_0;  1 drivers
v0x645ba694f340_0 .net "lt", 0 0, v0x645ba694ee10_0;  1 drivers
S_0x645ba693b9a0 .scope module, "uut" "comparator_4_bit_behavioral" 2 7, 3 1 0, S_0x645ba693b810;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "A";
    .port_info 1 /INPUT 4 "B";
    .port_info 2 /OUTPUT 1 "eq";
    .port_info 3 /OUTPUT 1 "gt";
    .port_info 4 /OUTPUT 1 "lt";
v0x645ba693bba0_0 .net "A", 3 0, v0x645ba694efc0_0;  1 drivers
v0x645ba694eba0_0 .net "B", 3 0, v0x645ba694f0a0_0;  1 drivers
v0x645ba694ec80_0 .var "eq", 0 0;
v0x645ba694ed50_0 .var "gt", 0 0;
v0x645ba694ee10_0 .var "lt", 0 0;
E_0x645ba6900f70 .event anyedge, v0x645ba693bba0_0, v0x645ba694eba0_0;
    .scope S_0x645ba693b9a0;
T_0 ;
    %wait E_0x645ba6900f70;
    %load/vec4 v0x645ba694eba0_0;
    %load/vec4 v0x645ba693bba0_0;
    %cmp/u;
    %jmp/0xz  T_0.0, 5;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645ba694ed50_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645ba694ee10_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645ba694ec80_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x645ba693bba0_0;
    %load/vec4 v0x645ba694eba0_0;
    %cmp/u;
    %jmp/0xz  T_0.2, 5;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645ba694ed50_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645ba694ee10_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645ba694ec80_0, 0, 1;
    %jmp T_0.3;
T_0.2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645ba694ed50_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645ba694ee10_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645ba694ec80_0, 0, 1;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x645ba693b810;
T_1 ;
    %vpi_call 2 16 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call 2 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x645ba693b810 {0 0 0};
    %vpi_call 2 18 "$monitor", "A = %b, B = %b, EQAL = %b, GREATER = %b, LOWER = %b", v0x645ba694efc0_0, v0x645ba694f0a0_0, v0x645ba694f170_0, v0x645ba694f270_0, v0x645ba694f340_0 {0 0 0};
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x645ba694efc0_0, 0, 4;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x645ba694f0a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x645ba694efc0_0, 0, 4;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x645ba694f0a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x645ba694efc0_0, 0, 4;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x645ba694f0a0_0, 0, 4;
    %delay 10, 0;
    %vpi_call 2 24 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb.v";
    "./design.v";
