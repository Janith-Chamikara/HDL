 .timescale 0 0;
    .port_info 0 /INPUT 4 "A";
    .port_info 1 /INPUT 4 "B";
    .port_info 2 /OUTPUT 1 "eq";
    .port_info 3 /OUTPUT 1 "gt";
    .port_info 4 /OUTPUT 1 "lt";
v0x5e05c88e4800_0 .net "A", 3 0, v0x5e05c89311c0_0;  1 drivers
v0x5e05c8930dd0_0 .net "B", 3 0, v0x5e05c89312a0_0;  1 drivers
