    .scope S_0x5e05c88e4490;
T_0 ;
    %vpi_call 2 9 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call 2 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e05c88e4490 {0 0 0};
    %vpi_call 2 11 "$monitor", "A = %b, B = %b, EQ = %b, GT = %b, LT = %b", v0x5e05c89311c0_0, v0x5e05c89312a0_0, v0x5e05c8931340_0, v0x5e05c8931440_0, v0x5e05c8931510_0 {0 0 0};
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5e05c89311c0_0, 0, 4;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5e05c89312a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5e05c89311c0_0, 0, 4;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5e05c89312a0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5e05c89311c0_0, 0, 4;
    %pushi/vec4 2, 0, 4;
